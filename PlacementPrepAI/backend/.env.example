# ---- Flask ----
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# ---- MySQL (for Aiven, copy these from the service's connection details) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=placementprep_ai
DB_USER=root
DB_PASSWORD=your-db-password
DB_SSL=false

# ---- Uploads ----
MAX_UPLOAD_MB=5

# ---- CORS (your frontend URL, no trailing slash) ----
FRONTEND_ORIGIN=http://localhost:5173

# ---- AI / LLM (optional; leave blank to use the rule-based fallback) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
